"use client";
import React, { useState, useEffect, useRef } from 'react';
import { useParams, useRouter } from 'next/navigation';
import { Button, Badge } from '../components/Primitives';

export default function ClipEditor() {
  const { id } = useParams();
  const router = useRouter();
  const videoRef = useRef<HTMLVideoElement>(null);

  const [clip, setClip] = useState<any>(null);
  const [transcript, setTranscript] = useState<any[]>([]);
  const [activeSegmentIndex, setActiveSegmentIndex] = useState(-1);
  const [captionStyle, setCaptionStyle] = useState({ color: '#8B5CF6', font: 'Archivo Black' });
  const [isSaving, setIsSaving] = useState(false);

  useEffect(() => {
    // Load clip and transcript data
    fetch(`http://localhost:8000/api/clips/${id}`)
      .then(res => res.json())
      .then(data => {
        setClip(data);
        // Mocking a split transcript for the editor
        setTranscript([
          { id: 1, start: 0, end: 5.2, text: "The secret to viral growth is consistency." },
          { id: 2, start: 5.2, end: 12.8, text: "Most people forget that distribution is half the battle." },
          { id: 3, start: 12.8, end: 20.1, text: "You have to optimize for the first three seconds." },
          { id: 4, start: 20.1, end: 30.5, text: "That is where you win or lose the viewer." },
        ]);
      });
  }, [id]);

  // Sync video time with transcript
  useEffect(() => {
    const video = videoRef.current;
    if (!video) return;

    const updateActiveSegment = () => {
      const currentTime = video.currentTime;
      const index = transcript.findIndex(s => currentTime >= s.start && currentTime <= s.end);
      setActiveSegmentIndex(index);
    };

    video.addEventListener('timeupdate', updateActiveSegment);
    return () => video.removeEventListener('timeupdate', updateActiveSegment);
  }, [transcript]);

  const jumpToSegment = (start: number, index: number) => {
    if (videoRef.current) {
      videoRef.current.currentTime = start;
      setActiveSegmentIndex(index);
    }
  };

  const updateText = (index: number, newText: string) => {
    const newTranscript = [...transcript];
    newTranscript[index].text = newText;
    setTranscript(newTranscript);
  };

  const deleteSegment = (index: number) => {
    const newTranscript = transcript.filter((_, i) => i !== index);
    setTranscript(newTranscript);
    // In a real app, this would trigger a recalculation of the video's duration/cut
  };

  const saveChanges = async () => {
    setIsSaving(true);
    await fetch(`http://localhost:8000/api/clips/${id}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ transcript, clip }),
    });
    setIsSaving(false);
    alert("Clip refined and saved!");
  };

  if (!clip) return <div className="min-h-screen bg-bg text-text flex items-center justify-center">Loading Editor...</div>;

  return (
    <div className="min-h-screen bg-bg text-text flex flex-col h-screen overflow-hidden">
      {/* Header */}
      <header className="h-16 border-b border-border flex items-center justify-between px-6 bg-surface">
        <div className="flex items-center gap-4">
          <Button variant="ghost" onClick={() => router.back()}>← Back</Button>
          <h1 className="text-lg font-bold">Refine Clip <span className="text-text-muted font-mono opacity-50">#{id.slice(0,8)}</span></h1>
        </div>
        <div className="flex items-center gap-3">
          <div className="flex items-center gap-2 mr-4 bg-bg p-1 rounded-md border border-border">
            <div
              className="w-4 h-4 rounded-full cursor-pointer border border-white/20"
              style={{ backgroundColor: '#8B5CF6' }}
              onClick={() => setCaptionStyle({ ...captionStyle, color: '#8B5CF6' })}
            />
            <div
              className="w-4 h-4 rounded-full cursor-pointer border border-white/20"
              style={{ backgroundColor: '#3B82F6' }}
              onClick={() => setCaptionStyle({ ...captionStyle, color: '#3B82F6' })}
            />
            <div
              className="w-4 h-4 rounded-full cursor-pointer border border-white/20"
              style={{ backgroundColor: '#FACC15' }}
              onClick={() => setCaptionStyle({ ...captionStyle, color: '#FACC15' })}
            />
          </div>
          <Button onClick={saveChanges} disabled={isSaving}>
            {isSaving ? 'Saving...' : 'Save Changes'}
          </Button>
        </div>
      </header>

      {/* Main Editor */}
      <div className="flex-1 flex overflow-hidden">
        {/* Left: Transcript Editor */}
        <div className="w-full md:w-1/3 border-r border-border bg-surface overflow-y-auto p-6">
          <h2 className="text-sm font-semibold text-text-muted uppercase tracking-wider mb-6">Transcript Editor</h2>
          <div className="space-y-4">
            {transcript.map((seg, idx) => (
              <div
                key={seg.id}
                className={`p-4 rounded-xl transition-all border ${
                  activeSegmentIndex === idx
                  ? 'bg-accent/10 border-accent shadow-[0_0_15px_rgba(139,92,246,0.1)]'
                  : 'bg-bg border-border hover:border-border-input'
                }`}
              >
                <div className="flex justify-between items-center mb-2">
                  <span
                    className="text-[10px] font-mono cursor-pointer hover:text-accent"
                    onClick={() => jumpToSegment(seg.start, idx)}
                  >
                    {seg.start}s - {seg.end}s
                  </span>
                  <button
                    onClick={() => deleteSegment(idx)}
                    className="text-text-muted hover:text-danger text-xs transition-colors"
                  >
                    Delete Cut
                  </button>
                </div>
                <textarea
                  className="w-full bg-transparent text-sm resize-none focus:outline-none leading-relaxed"
                  rows={2}
                  value={seg.text}
                  onChange={(e) => updateText(idx, e.target.value)}
                />
              </div>
            ))}
          </div>
        </div>

        {/* Right: Video Preview */}
        <div className="flex-1 bg-bg flex flex-col items-center justify-center p-12 relative">
          <div className="relative w-full max-w-sm aspect-[9/16] bg-black rounded-3xl shadow-2xl border-8 border-surface overflow-hidden">
            <video
              ref={videoRef}
              src="https://www.w3schools.com/html/mov_bbb.mp4" // Mock video source
              className="w-full h-full object-cover"
              controls
              loop
            />

            {/* Dynamic Caption Overlay */}
            {activeSegmentIndex !== -1 && (
              <div className="absolute bottom-20 left-0 right-0 text-center px-6 pointer-events-none">
                <span
                  className="text-2xl md:text-3xl font-black uppercase tracking-tighter text-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)] transition-all duration-200"
                  style={{
                    color: captionStyle.color,
                    fontFamily: captionStyle.font,
                    textShadow: `0 0 10px ${captionStyle.color}66`
                  }}
                >
                  {transcript[activeSegmentIndex].text}
                </span>
              </div>
            )}
          </div>
          <div className="mt-8 text-text-muted text-sm italic">
            Previewing 9:16 AI Center-Crop
          </div>
        </div>
      </div>
    </div>
  );
}
